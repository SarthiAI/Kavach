{
  "name": "kavach-engine",
  "version": "0.1.3",
  "description": "Compiled Rust engine for Kavach, a native Node.js addon exposing the gate evaluator via napi-rs.",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "SEE LICENSE IN ../LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SarthiAI/Kavach.git",
    "directory": "kavach-node"
  },
  "homepage": "https://github.com/SarthiAI/Kavach",
  "bugs": {
    "url": "https://github.com/SarthiAI/Kavach/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "napi": {
    "name": "kavach-engine",
    "triples": {
      "defaults": false,
      "additional": [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "aarch64-apple-darwin",
        "x86_64-pc-windows-msvc"
      ]
    }
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0"
  }
}
